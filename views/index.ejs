<%- include("layout/header") %>
    <main>
        <form action="/" method="POST">
            <label for="pLanguage">
                <input type="text" name="pLanguage" id="pLanguage" placeholder="Programming Language">
            </label>
            <input type="submit" value="Add">
        </form>
        <ul>

            <% if(pLanguages.length> 0){ %>
              <% for(const language of pLanguages){ %>
                   <li><%= language %></li>
               <% } %>
            <% } else { %>
                <p>No Data Found</p>
            <% } %>

        </ul>
    </main>
<%- include("layout/footer")%>